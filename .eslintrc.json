{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    // Základní pravidlo se plete na názvy parametrů v typech funkcí; hlídá ho TypeScriptová verze
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }],
    "no-console": "warn",
    "react/prop-types": "off",
    // Žádné alert/confirm/prompt: použijte toast (sonner) nebo ConfirmAction
    "no-restricted-globals": ["error",
      { "name": "alert", "message": "Použijte toast (sonner)." },
      { "name": "confirm", "message": "Použijte ConfirmAction." },
      { "name": "prompt", "message": "Použijte dialog s formulářem." }
    ],
    "no-restricted-properties": ["error",
      { "object": "window", "property": "alert", "message": "Použijte toast (sonner)." },
      { "object": "window", "property": "confirm", "message": "Použijte ConfirmAction." },
      { "object": "window", "property": "prompt", "message": "Použijte dialog s formulářem." }
    ]
  },
  "ignorePatterns": ["node_modules/", ".next/", "test-results/", "playwright-report/", "next-env.d.ts", "prisma/migrations/"],
  "overrides": [
    {
      // Skripty, seed a E2E běží v terminálu: výpisy do konzole jsou tam v pořádku
      "files": ["scripts/**", "prisma/**", "e2e/**", "playwright.config.ts", "*.config.*"],
      "rules": { "no-console": "off" }
    },
    {
      // Jádro (modules/core, lib, components, stránky jádra) o modulech nic neví – moduly do něj jen přispívají přes body rozšíření (modules/core/extensions.ts). Výjimka: modules/registry.ts a modules/server-registry.ts.
      "files": ["modules/core/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "app/**/*.{ts,tsx}", "middleware.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "group": ["@/modules/seminars", "@/modules/seminars/**", "**/modules/seminars/**"], "message": "Jádro nesmí importovat modul Semináře. Použijte bod rozšíření (modules/server-types.ts, modules/core/extensions.ts)." },
            { "group": ["@/modules/makeup", "@/modules/makeup/**", "**/modules/makeup/**"], "message": "Jádro nesmí importovat modul Dopisování. Použijte bod rozšíření (modules/server-types.ts, modules/core/extensions.ts)." }
          ]
        }]
      }
    },
    {
      // Moduly se navzájem neimportují (jen přes jádro a body rozšíření).
      "files": ["modules/seminars/**/*.{ts,tsx}", "app/enrollments/**/*.{ts,tsx}", "app/zapisy/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "group": ["@/modules/makeup", "@/modules/makeup/**", "**/modules/makeup/**"], "message": "Modul Semináře nesmí importovat modul Dopisování. Sdílené věci patří do jádra." }
          ]
        }]
      }
    },
    {
      "files": ["modules/makeup/**/*.{ts,tsx}", "app/makeup/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "group": ["@/modules/seminars", "@/modules/seminars/**", "**/modules/seminars/**"], "message": "Modul Dopisování nesmí importovat modul Semináře. Sdílené věci patří do jádra." }
          ]
        }]
      }
    }
  ]
}
