generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  STUDENT
  TEACHER
  ADMIN
}

// Stav studia studenta (u učitelů a adminů se nepoužívá)
enum StudyStatus {
  ACTIVE // studuje
  GRADUATED // absolvoval (po posledním ročníku)
  LEFT // ukončil studium jinak (viz StudyEndReason)
}

enum StudyEndReason {
  GRADUATED // absolvování
  TRANSFER // přestup na jinou školu
  WITHDRAWAL // zanechání studia
  EXPULSION // vyloučení
  OTHER
}

// Proč je student v daném roce v dané třídě
enum ClassChangeReason {
  ASSIGNED // první zařazení (import, ruční přiřazení)
  PROMOTED // postup do dalšího ročníku
  REPEATED // opakuje ročník
  MOVED // přeřazení během roku
}

enum Status {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
}

// Z čeho se skládá publikum zápisového okna (EnrollmentWindowAudience)
enum AudienceType {
  GRADE // ročník (hodnota v `grade`)
  CLASS // konkrétní třída (`classGroupId`)
  USER // konkrétní student (`userId`)
  EXCLUDE_USER // student, který je z publika vyňat (`userId`)
}

// Kdo vidí, kdo je na semináři zapsaný
enum ResultsVisibility {
  COUNTS // studenti vidí jen počty zapsaných
  NAMES // studenti vidí i jména zapsaných
}

model User {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String?
  role         Role      @default(GUEST)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // Nepovinná e-mailová upozornění (připomínky, souhrny); povinná chodí vždy
  receiveOptionalEmails Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Aktuální (u absolventů a ukončených poslední) třída studenta; null = není zařazen / není student.
  // Historie po letech je v ClassMembership – mění se vždy společně (modules/core/school.ts).
  classGroupId     String?
  classGroup       ClassGroup?       @relation("StudentClass", fields: [classGroupId], references: [id], onDelete: SetNull)
  classMemberships ClassMembership[]

  // Třída, kterou si uživatel přál při registraci (host čeká na schválení; po schválení se smaže)
  requestedClassGroupId String?
  requestedClassGroup   ClassGroup? @relation("RequestedClass", fields: [requestedClassGroupId], references: [id], onDelete: SetNull)

  // Stav studia (jen u studentů)
  studyStatus    StudyStatus     @default(ACTIVE)
  studyEndedAt   DateTime?
  studyEndReason StudyEndReason?
  studyEndNote   String?

  // Úvazky učitele (kdo co učí)
  teachingAssignments TeachingAssignment[]

  // Modul Dopisování
  makeupSessionsSupervised MakeupSession[]             @relation("MakeupSessionTeacher")
  makeupRegistrations      MakeupRegistration[]        @relation("MakeupRegistrationStudent")
  makeupSubjectsTaught     MakeupRegistrationSubject[] @relation("MakeupSubjectTeacher")

  // ====== zpětné relace ======
  // Subject
  subjectsCreated Subject[] @relation("SubjectCreatedBy")
  subjectsUpdated Subject[] @relation("SubjectUpdatedBy")

  // EnrollmentWindow
  enrollmentAudiences      EnrollmentWindowAudience[] @relation("AudienceUser")
  enrollmentWindowsCreated EnrollmentWindow[]         @relation("EnrollmentWindowCreatedBy")
  enrollmentWindowsUpdated EnrollmentWindow[]         @relation("EnrollmentWindowUpdatedBy")

  // Block
  blocksCreated Block[] @relation("BlockCreatedBy")
  blocksUpdated Block[] @relation("BlockUpdatedBy")
  blocksDeleted Block[] @relation("BlockDeletedBy")

  // SubjectOccurrence
  subjectOccurrencesTaught  SubjectOccurrence[] @relation("SubjectOccurrenceTeacher")
  subjectOccurrencesCreated SubjectOccurrence[] @relation("SubjectOccurrenceCreatedBy")
  subjectOccurrencesUpdated SubjectOccurrence[] @relation("SubjectOccurrenceUpdatedBy")
  subjectOccurrencesDeleted SubjectOccurrence[] @relation("SubjectOccurrenceDeletedBy")

  // StudentEnrollment
  studentEnrollments        StudentEnrollment[] @relation("EnrollmentStudent")
  studentEnrollmentsCreated StudentEnrollment[] @relation("EnrollmentCreatedBy")
  studentEnrollmentsUpdated StudentEnrollment[] @relation("EnrollmentUpdatedBy")
  studentEnrollmentsDeleted StudentEnrollment[] @relation("EnrollmentDeletedBy")
}

// =====================================================================
// MODUL SEMINÁŘE
// =====================================================================

model EnrollmentWindow {
  id                String   @id @default(cuid())
  name              String
  description       String?
  status            Status   @default(DRAFT)
  startsAt          DateTime
  endsAt            DateTime
  visibleToStudents Boolean  @default(false)

  // Publikum: sjednocení ročníků, tříd a konkrétních studentů minus vynechaní; prázdné = všichni aktivní studenti
  audience EnrollmentWindowAudience[]

  // Pravidla okna
  // Smí se student sám odepsat (a přepsat zápis)?
  allowSelfUnenroll Boolean           @default(true)
  // Studenti mohou měnit zápis (odepsat, přepsat) nejpozději do tohoto času; null = do konce okna
  changesUntil      DateTime?
  // Co o zapsaných vidí studenti
  resultsVisibility ResultsVisibility @default(COUNTS)

  // Automatická připomínka nezapsaným N dní před koncem (null = ne); provádí denní cron
  reminderDaysBefore Int?
  // Datum (Europe/Prague, RRRR-MM-DD), kdy se automatická připomínka odeslala; null = ještě ne
  reminderSentOn     String?
  // Kdy se odeslalo upozornění „zápis otevřen“ (null = ještě ne)
  openedNotifiedAt   DateTime?

  createdById String
  createdBy   User   @relation("EnrollmentWindowCreatedBy", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("EnrollmentWindowUpdatedBy", fields: [updatedById], references: [id])

  blocks Block[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Block {
  id          String  @id @default(cuid())
  name        String
  order       Int
  description String?

  // Povinný blok: student v něm má mít aspoň `minEnrollments` zápisů (nezapsaní počítají jen povinné bloky)
  required       Boolean @default(true)
  // Kolik zápisů (různých výskytů) v bloku smí a má student mít
  minEnrollments Int     @default(1)
  maxEnrollments Int     @default(1)

  enrollmentWindowId String
  enrollmentWindow   EnrollmentWindow @relation(fields: [enrollmentWindowId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("BlockCreatedBy", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("BlockUpdatedBy", fields: [updatedById], references: [id])

  subjectOccurrences SubjectOccurrence[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("BlockDeletedBy", fields: [deletedById], references: [id])

  @@unique([enrollmentWindowId, order])
  @@index([enrollmentWindowId])
}

model SubjectOccurrence {
  id String @id @default(cuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  blockId String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   User?   @relation("SubjectOccurrenceTeacher", fields: [teacherId], references: [id])

  subCode  String?
  capacity Int? // null = neomezená kapacita

  // Omezení výskytu na ročníky a třídy (sjednocení); obojí prázdné = pro všechny z publika okna
  restrictGrades  Int[]        @default([])
  restrictClasses ClassGroup[] @relation("OccurrenceClasses")

  createdById String
  createdBy   User   @relation("SubjectOccurrenceCreatedBy", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("SubjectOccurrenceUpdatedBy", fields: [updatedById], references: [id])

  studentEnrollments StudentEnrollment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("SubjectOccurrenceDeletedBy", fields: [deletedById], references: [id])

  @@index([subjectId])
  @@index([blockId])
}

model StudentEnrollment {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("EnrollmentStudent", fields: [studentId], references: [id])

  subjectOccurrenceId String
  subjectOccurrence   SubjectOccurrence @relation(fields: [subjectOccurrenceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("EnrollmentCreatedBy", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("EnrollmentUpdatedBy", fields: [updatedById], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("EnrollmentDeletedBy", fields: [deletedById], references: [id])

  @@index([studentId])
  @@index([subjectOccurrenceId])
}

// Položka publika zápisového okna. Publikum = (ročníky ∪ třídy ∪ studenti) \ vynechaní studenti;
// bez položek GRADE/CLASS/USER = všichni aktivní studenti. Vyhodnocuje ho jediné místo:
// modules/seminars/eligibility.ts (isInAudience / audienceWhere).
model EnrollmentWindowAudience {
  id String @id @default(cuid())

  windowId String
  window   EnrollmentWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)

  type AudienceType

  grade        Int?
  classGroupId String?
  classGroup   ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation("AudienceUser", fields: [userId], references: [id], onDelete: Cascade)

  // Jedinečnost položky v okně: "GRADE:3", "CLASS:<id>", "USER:<id>", "EXCLUDE_USER:<id>"
  key String

  createdAt DateTime @default(now())

  @@unique([windowId, key])
  @@index([userId])
  @@index([classGroupId])
}

model SystemSetting {
  key   String @id
  value String
}

// =====================================================================
// JÁDRO – E-MAILY A HISTORIE ZMĚN
// =====================================================================

enum EmailLogStatus {
  SENT // odesláno (u EMAIL_TRANSPORT=log jen zapsáno)
  FAILED // odeslání selhalo (viz error)
  SKIPPED_LIMIT // nad denním/měsíčním limitem
  SKIPPED_DISABLED // vypnuté upozornění nebo příjemce odhlášen z nepovinných
}

// Každý pokus o odeslání e-mailu; slouží i k počítání limitů (stav SENT)
model EmailLog {
  id              String         @id @default(cuid())
  recipient       String
  // bez relace: záznam přežije smazání uživatele
  recipientUserId String?
  // id události (lib/email/events.ts), např. makeup.session.cancelled
  event           String
  subject         String
  status          EmailLogStatus
  error           String?
  // id zprávy u Resendu
  providerId      String?
  createdAt       DateTime       @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([event, createdAt])
  @@index([recipientUserId])
}

// Historie změn: kdo, co a kdy změnil. Zapisuje se ve stejné transakci jako změna.
// Bez relací na User, aby záznamy přežily smazání uživatele (jméno je uložené v actorName).
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorName      String?
  // admin, který v režimu „zobrazit jako“ jednal za actorId
  impersonatorId String?
  // oblast.entita.akce, např. makeup.registration.remove
  action         String
  entityType     String
  entityId       String?
  // čitelný popis česky
  summary        String
  // před/po
  data           Json?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

// =====================================================================
// JÁDRO – ŠKOLA (sdílené všemi moduly)
// =====================================================================

// Školní rok, např. startYear 2026 = 2026/27. Právě jeden je aktuální.
model SchoolYear {
  id        String  @id @default(cuid())
  startYear Int     @unique
  isCurrent Boolean @default(false)

  teachingAssignments TeachingAssignment[]
  classMemberships    ClassMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pevná třída (1.A … 4.C). Studenti se mezi třídami jen přesouvají, třídy se zakládají jednou.
// Ročník studenta = grade jeho třídy; historie po letech je v ClassMembership.
model ClassGroup {
  id     String @id @default(cuid())
  grade  Int
  letter String

  students              User[]                     @relation("StudentClass")
  requestedBy           User[]                     @relation("RequestedClass")
  teachingAssignments   TeachingAssignment[]
  classMemberships      ClassMembership[]
  // zápisy seminářů: publika oken a omezení výskytů, ve kterých je třída uvedena
  enrollmentAudiences   EnrollmentWindowAudience[]
  restrictedOccurrences SubjectOccurrence[]        @relation("OccurrenceClasses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([grade, letter])
}

// Předmět (Matematika, Čeština, volitelný seminář, …). Do zápisu (blok zápisového okna)
// lze zařadit jakýkoli aktivní předmět; nemá žádný „typ“.
model Subject {
  id          String  @id @default(cuid())
  name        String
  // Zkratka; nepovinná, ale jedinečná
  code        String? @unique
  description String?
  syllabus    String?
  // Ročníky (1–4), ve kterých se předmět vyučuje; prázdné = všechny
  grades      Int[]   @default([])
  isActive    Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("SubjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("SubjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  teachingAssignments TeachingAssignment[]
  // výskyty předmětu v zápisových oknech (modul Semináře)
  subjectOccurrences  SubjectOccurrence[]
  makeupSessions      MakeupSessionSubject[]
  makeupRegistrations MakeupRegistrationSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Úvazek: učitel učí předmět ve třídě v daném školním roce
model TeachingAssignment {
  id String @id @default(cuid())

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  schoolYearId String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId, classGroupId, schoolYearId])
  @@index([schoolYearId, classGroupId])
  @@index([subjectId])
}

// Historie zařazení: v jaké třídě a ročníku byl student v daném školním roce
model ClassMembership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  schoolYearId String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  // Ročník v tom roce (uložený, aby historie nezávisela na pozdějších změnách tříd)
  grade  Int
  reason ClassChangeReason @default(ASSIGNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, schoolYearId])
  @@index([schoolYearId, classGroupId])
}

// =====================================================================
// MODUL DOPISOVÁNÍ PÍSEMEK
// =====================================================================

// Termín dopisování = čas a místo učitele (dozoru), na který se zapisují studenti
model MakeupSession {
  id String @id @default(cuid())

  // dozor
  teacherId String
  teacher   User   @relation("MakeupSessionTeacher", fields: [teacherId], references: [id])

  startsAt              DateTime
  endsAt                DateTime
  room                  String
  capacity              Int
  // Zápis, odhlášení i přepis jsou možné nejpozději tolik minut před začátkem
  changeDeadlineMinutes Int      @default(60)
  note                  String?

  // Termíny vytvořené jako opakovaná řada sdílí seriesId
  seriesId String?

  cancelledAt  DateTime?
  cancelReason String?

  subjects      MakeupSessionSubject[]
  registrations MakeupRegistration[]

  // kdo termín vytvořil (bez relace – historie, ne vazba)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt])
  @@index([teacherId, startsAt])
  @@index([seriesId])
}

// Předměty, které lze na termínu dopisovat
model MakeupSessionSubject {
  sessionId String
  session   MakeupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([sessionId, subjectId])
}

enum MakeupAttendance {
  REGISTERED // zapsán, termín ještě neproběhl / docházka nezapsána
  ATTENDED // dopsal(a)
  NO_SHOW // nedostavil(a) se
}

// Zápis studenta na termín
model MakeupRegistration {
  id String @id @default(cuid())

  sessionId String
  session   MakeupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("MakeupRegistrationStudent", fields: [studentId], references: [id], onDelete: Cascade)

  // volitelná poznámka studenta (např. které téma chce dopsat)
  note       String?
  attendance MakeupAttendance @default(REGISTERED)

  subjects MakeupRegistrationSubject[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// Předmět, který student na termínu dopisuje, a jeho vyučující dohledaný z úvazků
model MakeupRegistrationSubject {
  registrationId String
  registration   MakeupRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // vyučující, kterému student písemku dopisuje (null = úvazek není zadaný)
  subjectTeacherId String?
  subjectTeacher   User?   @relation("MakeupSubjectTeacher", fields: [subjectTeacherId], references: [id], onDelete: SetNull)

  @@id([registrationId, subjectId])
  @@index([subjectTeacherId])
}

// =====================================================================
// JÁDRO – UKÁZKOVÁ DATA PRO PREZENTACI
// =====================================================================

// Evidence záznamů vytvořených funkcí „Naplnit ukázkovými daty“ (Administrace → Ukázková data).
// Zapisuje se ve stejné transakci jako samotný záznam. Mazání ukázkových dat smí smazat jen to,
// co je tady uvedeno (a co na tom závisí přes kaskádu). Bez relací: `model` je název modelu Prisma.
model DemoRecord {
  id        String   @id @default(cuid())
  model     String
  recordId  String
  createdAt DateTime @default(now())

  @@unique([model, recordId])
}
